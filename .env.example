# =================================================================
# JARVIS 本地开发 · 环境变量模板
#
# 用法（推荐）：
#   cp .env.example .env
#   # 至少修改 AGENTSCOPE_API_KEY 为真实 Key
#   vim .env
#   ./run.sh        # 自动读取 .env 并启动后端
#
# 说明：
#   .env 文件默认已被 .gitignore 忽略，不会被提交（内含密钥，务必勿提交）
#   所有变量都有 application.properties 兜底默认值，一般只需改必填项。
# =================================================================

# ============================================================
# 🔑  聊天模型（必填，否则 AI 对话报 401）
#    获取：https://platform.deepseek.com/   → API Keys
#    兼容 OpenAI 协议的任何服务都可以填（如：月之暗面、Qwen、本地 Ollama/open-webui 反代）
# ============================================================
# 示例：DeepSeek 官方
AGENTSCOPE_API_KEY=sk-your-real-deepseek-key-here
AGENTSCOPE_BASE_URL=https://api.deepseek.com/v1
AGENTSCOPE_MODEL=deepseek-chat
# 其他可选模型示例：
#   DeepSeek R1 推理模型：AGENTSCOPE_MODEL=deepseek-reasoner
#   硅基流动（SiliconFlow）Qwen：AGENTSCOPE_BASE_URL=https://api.siliconflow.cn/v1
#   OpenAI：   AGENTSCOPE_BASE_URL=https://api.openai.com/v1
#              AGENTSCOPE_MODEL=gpt-4o-mini

# Agent 行为（可选）
AGENTSCOPE_AGENT_NAME=jarvis-assistant
#AGENTSCOPE_AGENT_SYS_PROMPT=你是JARVIS小助手，用中文回答；回答时必须引用知识库片段并标注 [n]
#AGENTSCOPE_AGENT_MAX_ITERS=10

# ============================================================
# 🔐  JWT（可选，默认值能跑，但生产环境务必改成随机 32+ 字符）
#    生成方式：openssl rand -hex 32
# ============================================================
AUTH_JWT_SECRET=dev-only-please-change-in-prod-change-me-0000
AUTH_JWT_EXPIRE_SECONDS=604800

# ============================================================
# 🗄  数据库（本地 MySQL brew services 启动，或外部 MySQL）
#    本地 brew 安装默认：用户 jarvis / jarvis123 @ 127.0.0.1:3306/jarvis
# ============================================================
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/jarvis?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
MYSQL_USERNAME=jarvis
MYSQL_PASSWORD=jarvis123

# ============================================================
# 🧠 RAG & 向量模型（Ollama，本地）
#    需要本机安装 Ollama 并 ollama pull bge-m3
# ============================================================
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_TIMEOUT_SECONDS=120
RAG_EMBEDDING_KEEP_ALIVE=60m
RAG_EMBEDDING_BATCH_SIZE=4
RAG_CHUNK_MAX_CHARS=500
RAG_TOP_K=4
RAG_MIN_SCORE=0.40
