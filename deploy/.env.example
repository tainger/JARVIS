# =================================================================
# JARVIS Docker 部署 · 环境变量模板
#   cp deploy/.env.example .env
#   然后按需修改，至少填 AGENTSCOPE_API_KEY；其他都有默认值
# =================================================================

# ---------- 聊天模型（DeepSeek 示例）----------
# 必填！占位符 sk-demo-key 会被直接拒绝（401）
AGENTSCOPE_API_KEY=sk-your-real-deepseek-key-here
AGENTSCOPE_BASE_URL=https://api.deepseek.com/v1
AGENTSCOPE_MODEL=deepseek-chat

# Agent 行为
AGENTSCOPE_AGENT_NAME=jarvis-assistant
AGENTSCOPE_AGENT_SYS_PROMPT=You are JARVIS, a helpful assistant. Use the available tools to answer questions about tasks.
AGENTSCOPE_AGENT_MAX_ITERS=10

# ---------- 用户认证 JWT ----------
# ⚠️ 生产环境必须改成至少 32 字符的随机字符串，否则 Token 可被伪造
AUTH_JWT_SECRET=please-change-me-to-a-32-char-random-string-here-123456
# Token 过期时间（秒），默认 7 天 = 604800
AUTH_JWT_EXPIRE_SECONDS=604800

# ---------- 数据库（MySQL 8.4）----------
# 容器内业务库账号；backend 通过服务名 mysql 连接，不暴露主机端口
MYSQL_URL=jdbc:mysql://mysql:3306/jarvis?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
MYSQL_USERNAME=jarvis
MYSQL_PASSWORD=jarvis123
MYSQL_ROOT_PASSWORD=jarvis-root

# ---------- RAG & 向量模型 ----------
# 只要用默认 Ollama 镜像就保持 bge-m3
RAG_EMBEDDING_MODEL=bge-m3
RAG_TOP_K=4

# ---------- 主机端口 ----------
# 访问前端入口用这个
JARVIS_FRONTEND_PORT=8080
# 后端直连端口（一般只用前端 /api 反代，这个可以不暴露给公网）
JARVIS_BACKEND_PORT=18080
# Ollama 暴露给主机（方便本机 ollama CLI 也能管理）
OLLAMA_PORT=11434
# 可选 WebUI
OLLAMA_WEBUI_PORT=3000

# ---------- 性能 ----------
BACKEND_MAX_MEM_MB=1024
