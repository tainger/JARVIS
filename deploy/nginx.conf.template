server {
    listen       80;
    server_name  _;

    # 静态资源缓存（React SPA 有 hash，缓存 30 天）
    location /assets/ {
        root   /usr/share/nginx/html;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    # /api → 后端服务（默认 http://jarvis-backend:8080）
    location /api/ {
        proxy_pass         ${BACKEND_HOST}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # SSE 流式聊天：必须禁用缓冲 + 长超时
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # H2 Console 直通：部署到公网时建议删掉这段或加白名单
    location /h2-console/ {
        proxy_pass         ${BACKEND_HOST}/h2-console/;
        proxy_set_header   Host $host;
    }

    # SPA 路由 fallback：任何非 api/asset 的路径都回 index.html
    location / {
        root   /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
