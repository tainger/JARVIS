<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

	<!-- 从 Spring 环境读取日志目录（application.properties 的 logging.file.path）；默认回退到项目根下 log/ -->
	<springProperty scope="context" name="LOG_PATH" source="logging.file.path"
		defaultValue="${user.dir}/log"/>

	<property name="LOG_PATTERN"
		value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n"/>
	<property name="CHARSET" value="UTF-8"/>
	<property name="MAX_HISTORY" value="30"/>
	<property name="TOTAL_SIZE_CAP" value="3GB"/>

	<!-- ============== 控制台输出 ============== -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder charset="${CHARSET}">
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- ============== INFO 级别按天滚动文件 ============== -->
	<appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_PATH}/jarvis-info.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_PATH}/archived/jarvis-info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>50MB</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>INFO</level>
			<onMatch>ACCEPT</onMatch>
			<onMismatch>DENY</onMismatch>
		</filter>
		<encoder charset="${CHARSET}">
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- ============== ERROR 级别按天滚动文件 ============== -->
	<appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_PATH}/jarvis-error.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_PATH}/archived/jarvis-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>50MB</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
		<encoder charset="${CHARSET}">
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- ============== 全量（含 DEBUG/WARN）按天滚动文件 ============== -->
	<appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_PATH}/jarvis-all.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_PATH}/archived/jarvis-all.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>50MB</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder charset="${CHARSET}">
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- ============== 日志级别 ============== -->
	<!-- 级别不写死，由 application.properties 的 logging.level.* 决定；只需绑定 appender -->
	<logger name="com.example.jarvis" additivity="false">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="INFO_FILE"/>
		<appender-ref ref="ERROR_FILE"/>
		<appender-ref ref="ALL_FILE"/>
	</logger>

	<!-- MyBatis 通过 SLF4J 桥接输出，Mapper SQL 在 DEBUG 级可见 -->
	<logger name="com.example.jarvis.mapper" additivity="false">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="INFO_FILE"/>
		<appender-ref ref="ERROR_FILE"/>
		<appender-ref ref="ALL_FILE"/>
	</logger>

	<logger name="org.apache.ibatis" additivity="false">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="ALL_FILE"/>
	</logger>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="INFO_FILE"/>
		<appender-ref ref="ERROR_FILE"/>
		<appender-ref ref="ALL_FILE"/>
	</root>

</configuration>
